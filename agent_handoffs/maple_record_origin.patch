+"""Explicit completed-event origins preserve native clocks and finalization guards."""
+import dataclasses
+import math
+import numpy as np
+import pytest
+from maple.aeolian.scheduler.finalization import finalize_wind_event, WindEventFinalizationError
+from maple.aeolian.cohorts.dispatch import mobile_state_is_genuinely_empty
+from maple.core.backend import array_leaves
+from tests.unit.test_wind_event_finalization import (
+    _geometry, _one, _state_and_config, _assert_finalized_shell, _budget_closes,
+    _bed_by_cell, _expected_request,
+)
+
+
+def absolute_state(origin=169.0, mass=1e-3):
+    # Test fixture uses actual absolute kinematics; no rebasing happens in the API.
+    state, cfg, record, _ = _state_and_config([
+        _one(_geometry(), launch=origin + 9.5, impact=origin + 10.5, mass=mass)])
+    state = dataclasses.replace(state, physical=dataclasses.replace(state.physical, time_s=origin + 10.0))
+    return state, cfg, record
+
+
+@pytest.mark.parametrize('origin', [0.0, 169.0, 1e6])
+@pytest.mark.parametrize('mass', [1e-3, 1e-14])
+def test_absolute_clock_position_tiny_inventory_and_repeat(origin, mass):
+    state, cfg, record = absolute_state(origin, mass)
+    original = [a.copy() for a in array_leaves(state)]
+    result = finalize_wind_event(state, cfg, record, record_origin_s=origin)
+    _assert_finalized_shell(result, state, cfg)
+    _budget_closes(result, state, 1)
+    # Absolute time must not become trajectory age: age is exactly 0.5 s,
+    # at 1 m/s east, regardless of the event's origin.
+    expected, exported = _expected_request(cfg.geometry, 1, [1.75], [1.25], [0], [mass])
+    np.testing.assert_allclose(_bed_by_cell(result.state.physical) - _bed_by_cell(state.physical),
+                               expected, rtol=0.0, atol=result.reservoir_identity_bound_kg)
+    np.testing.assert_array_equal(result.boundary_export_mass_by_class_kg, exported)
+    assert result.airborne_mass_before_by_class_kg[0] == mass
+    assert result.deposited_mass_by_class_kg[0] + result.boundary_export_mass_by_class_kg[0] > 0
+    assert result.state.physical.time_s.hex() == state.physical.time_s.hex()
+    for before, after in zip(original, array_leaves(state), strict=True):
+        np.testing.assert_array_equal(before, after)
+    repeat = finalize_wind_event(result.state, cfg, record, record_origin_s=origin)
+    assert repeat.completed and repeat.status == 'already_empty'
+    assert not np.any(repeat.deposited_mass_by_class_kg) and not np.any(repeat.boundary_export_mass_by_class_kg)
+
+
+@pytest.mark.parametrize('origin', [True, np.bool_(False), -1.0, -0.0, math.inf, math.nan, '169', 10**1000])
+def test_bad_origin_fails_before_mutation(origin):
+    state, cfg, record = absolute_state()
+    original = [a.copy() for a in array_leaves(state)]
+    with pytest.raises(WindEventFinalizationError, match='record_origin_s'):
+        finalize_wind_event(state, cfg, record, record_origin_s=origin)
+    for before, after in zip(original, array_leaves(state), strict=True):
+        np.testing.assert_array_equal(before, after)
+
+
+def test_wrong_origin_and_original_cursor_wind_guards_remain():
+    state, cfg, record = absolute_state()
+    for origin in [0.0, 168.0, 170.0]:
+        with pytest.raises(WindEventFinalizationError, match='end time'):
+            finalize_wind_event(state, cfg, record, record_origin_s=origin)
+    for bad in [dataclasses.replace(state, block_index=0),
+                dataclasses.replace(state, block_offset_s=0.1),
+                dataclasses.replace(state, last_resolved_wind=None)]:
+        with pytest.raises(WindEventFinalizationError):
+            finalize_wind_event(bad, cfg, record, record_origin_s=169.0)
+    with pytest.raises(WindEventFinalizationError, match='advancing time'):
+        finalize_wind_event(state, cfg, record, record_origin_s=1e308)
+
+
+def test_omitted_origin_preserves_zero_based_api():
+    state, cfg, record = absolute_state(0.0)
+    default = finalize_wind_event(state, cfg, record)
+    explicit = finalize_wind_event(state, cfg, record, record_origin_s=0.0)
+    assert default.completed and explicit.completed
+    for name in ('deposited_mass_by_class_kg', 'boundary_export_mass_by_class_kg', 'bed_change_by_class_kg'):
+        np.testing.assert_array_equal(getattr(default, name), getattr(explicit, name))
